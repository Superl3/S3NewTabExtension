# Local connector credentials (copy to connector/.env and keep private)
PORT=8787

# Quick token relay (sets access_token without running OAuth)
MONDAY_ACCESS_TOKEN=your_monday_access_token
MONDAY_ACCOUNT_LABEL=Monday User
GOOGLE_ACCESS_TOKEN=your_google_access_token
GOOGLE_ACCOUNT_LABEL=Your Name
OPENAI_ACCESS_TOKEN=your_openai_api_key
OPENAI_ACCOUNT_LABEL=OpenAI User

# OAuth clients (optional: enables real OAuth consent flows)
MONDAY_CLIENT_ID=your_monday_client_id
MONDAY_CLIENT_SECRET=your_monday_client_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Optional override if you host the connector elsewhere
CONNECTOR_BASE_URL=http://localhost:8787

# Optional: allow redirect_uri to any HTTPS host (default: only chromiumapp.org + localhost)
# ALLOW_ANY_HTTPS_REDIRECT=1
