# Local connector credentials (copy to connector/.env and keep private)
PORT=8787

# Quick token relay (sets access_token without running OAuth)
MONDAY_ACCESS_TOKEN=your_monday_access_token
MONDAY_ACCOUNT_LABEL=Monday User
GOOGLE_ACCESS_TOKEN=your_google_access_token
GOOGLE_ACCOUNT_LABEL=Your Name
OPENAI_ACCESS_TOKEN=your_openai_api_key
OPENAI_ACCOUNT_LABEL=OpenAI User

# OAuth clients (optional: enables real OAuth consent flows)
MONDAY_CLIENT_ID=your_monday_client_id
MONDAY_CLIENT_SECRET=your_monday_client_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Optional override if you host the connector elsewhere
CONNECTOR_BASE_URL=http://localhost:8787

# Redirect policy is strict by default:
# - https://{extension-id}.chromiumapp.org is allowed only for IDs in ALLOWED_EXTENSION_IDS
# - chrome-extension://{extension-id} is allowed only when both ALLOW_CHROME_EXTENSION_REDIRECT=1
#   and ALLOWED_EXTENSION_IDS contains the extension-id
# - http://localhost and http://127.0.0.1 are allowed for local development

# Optional: allowlist extension IDs for chrome-extension:// redirects
# ALLOWED_EXTENSION_IDS=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Optional: allow chrome-extension:// redirect URIs (requires ALLOWED_EXTENSION_IDS)
# ALLOW_CHROME_EXTENSION_REDIRECT=1

# Optional: OAuth request timeout in milliseconds
# OAUTH_REQUEST_TIMEOUT_MS=15000
