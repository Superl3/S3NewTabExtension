{
  "version": 2,
  "defaults": {
    "ui": {
      "theme": {
        "fontFamily": "\"IBM Plex Sans\", \"Segoe UI\", sans-serif"
      },
      "background": {
        "mode": "wallpaper",
        "wallpaperProvider": "picsum",
        "wallpaperTheme": "nature",
        "redditSubreddit": "EarthPorn",
        "redditTime": "week",
        "rotateMinutes": 15,
        "videoSource": "manual",
        "videoUrl": "",
        "redditVideoSubreddit": "loopingvideos",
        "redditVideoTime": "week",
        "blurAmount": 0,
        "overlayOpacity": 0.24
      },
      "home": {
        "mode": "grid",
        "gridColumns": 12,
        "gridRows": 8,
        "marginHorizontal": "medium",
        "marginVertical": "medium",
        "itemGap": "narrow",
        "pageCount": 2,
        "dockEnabled": true,
        "dockShape": "raised",
        "dockVisibility": "always",
        "dockPosition": "bottom",
        "dockLength": 6,
        "dockHeight": 44,
        "widgetBackdropBlur": true
      },
      "widgetCommonMaster": {
        "viewMode": "window",
        "surfaceMode": "normal",
        "transparentAutoContrast": true,
        "transparentGhostStrength": 100,
        "backdropBlur": true,
        "edgeRoundness": 12,
        "transparency": 0.3,
        "titleAlign": "center",
        "contentAlignY": "top",
        "contentFillParent": false,
        "contentPadding": 10,
        "contentFontScale": 1,
        "widgetThemeMode": "inherit",
        "useCustomColors": false,
        "customTextColor": "#1F2226",
        "customAccentColor": "#1F4F9F",
        "customSurfaceColor": "#FFFAF2"
      }
    }
  },
  "presets": {
    "compact-grid": {
      "ui": {
        "home": {
          "gridColumns": 12,
          "gridRows": 8,
          "itemGap": "narrow"
        }
      }
    },
    "focus-surface": {
      "ui": {
        "widgetCommonMaster": {
          "surfaceMode": "normal",
          "contentFillParent": false
        }
      }
    }
  },
  "applyPresets": [
    "compact-grid",
    "focus-surface"
  ]
}
