{
  "version": 2,
  "defaults": {
    "ui": {
      "theme": {
        "fontFamily": "\"IBM Plex Sans\", \"Segoe UI\", sans-serif"
      },
      "background": {
        "mode": "wallpaper",
        "wallpaperProvider": "picsum",
        "wallpaperTheme": "nature",
        "redditSubreddit": "EarthPorn",
        "redditTime": "week",
        "rotateMinutes": 15,
        "videoSource": "manual",
        "videoUrl": "",
        "redditVideoSubreddit": "loopingvideos",
        "redditVideoTime": "week",
        "blurAmount": 0,
        "overlayOpacity": 0.24
      },
      "home": {
        "mode": "grid",
        "gridColumns": 12,
        "gridRows": 8,
        "marginHorizontal": "medium",
        "marginVertical": "medium",
        "itemGap": "narrow",
        "pageCount": 2,
        "dockEnabled": true,
        "dockShape": "raised",
        "dockVisibility": "always",
        "dockPosition": "bottom",
        "dockLength": 6,
        "dockHeight": 44,
        "widgetBackdropBlur": true
      },
      "widgetCommonMaster": {
        "viewMode": "window",
        "surfaceMode": "normal",
        "transparentAutoContrast": true,
        "transparentGhostStrength": 100,
        "backdropBlur": true,
        "edgeRoundness": 12,
        "transparency": 0.3,
        "titleAlign": "center",
        "contentAlignY": "top",
        "contentFillParent": false,
        "contentPadding": 10,
        "contentFontScale": 1,
        "widgetThemeMode": "inherit",
        "useCustomColors": false,
        "customTextColor": "#1F2226",
        "customAccentColor": "#1F4F9F",
        "customSurfaceColor": "#FFFAF2"
      }
    }
  },
  "presets": {
    "compact-grid": {
      "ui": {
        "home": {
          "gridColumns": 12,
          "gridRows": 8,
          "itemGap": "narrow"
        }
      }
    },
    "focus-surface": {
      "ui": {
        "widgetCommonMaster": {
          "surfaceMode": "normal",
          "contentFillParent": false
        }
      }
    }
  },
  "applyPresets": [
    "compact-grid",
    "focus-surface"
  ],
  "overrides": {
    "instances": [
      {
        "id": "clock-1",
        "type": "clock",
        "gridLayout": {
          "col": 0,
          "row": 0,
          "colSpan": 3,
          "rowSpan": 2
        }
      },
      {
        "id": "search-2",
        "type": "search",
        "gridLayout": {
          "col": 3,
          "row": 0,
          "colSpan": 6,
          "rowSpan": 1
        }
      },
      {
        "id": "shortcut-5",
        "type": "shortcut",
        "dockOrder": 0,
        "gridLayout": {
          "col": 9,
          "row": 0,
          "colSpan": 1,
          "rowSpan": 1
        }
      },
      {
        "id": "bookmarks-4",
        "type": "bookmarks",
        "gridLayout": {
          "col": 10,
          "row": 0,
          "colSpan": 2,
          "rowSpan": 4
        }
      },
      {
        "id": "label-8",
        "type": "label",
        "gridLayout": {
          "col": 3,
          "row": 1,
          "colSpan": 6,
          "rowSpan": 1
        }
      },
      {
        "id": "aiChat-3",
        "type": "aiChat",
        "gridLayout": {
          "col": 0,
          "row": 2,
          "colSpan": 4,
          "rowSpan": 4
        }
      },
      {
        "id": "todo-6",
        "type": "todo",
        "gridLayout": {
          "col": 4,
          "row": 2,
          "colSpan": 3,
          "rowSpan": 3
        }
      },
      {
        "id": "notes-7",
        "type": "notes",
        "gridLayout": {
          "col": 7,
          "row": 2,
          "colSpan": 3,
          "rowSpan": 3
        }
      }
    ]
  }
}
