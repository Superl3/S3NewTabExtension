{
  "version": 2,
  "defaults": {
    "ui": {
      "theme": {
        "fontFamily": "\"IBM Plex Sans\", \"Segoe UI\", sans-serif"
      },
      "background": {
        "mode": "wallpaper",
        "wallpaperProvider": "picsum",
        "wallpaperTheme": "nature",
        "redditSubreddit": "EarthPorn",
        "redditTime": "week",
        "rotateMinutes": 15,
        "videoSource": "manual",
        "videoUrl": "",
        "redditVideoSubreddit": "loopingvideos",
        "redditVideoTime": "week",
        "blurAmount": 0,
        "overlayOpacity": 0.24
      },
      "home": {
        "mode": "grid",
        "gridColumns": 12,
        "gridRows": 8,
        "marginHorizontal": "medium",
        "marginVertical": "medium",
        "itemGap": "narrow",
        "pageCount": 1,
        "dockEnabled": false,
        "dockShape": "raised",
        "dockVisibility": "always",
        "dockPosition": "bottom",
        "dockLength": 6,
        "dockHeight": 44,
        "widgetBackdropBlur": true
      },
      "widgetCommonMaster": {
        "viewMode": "window",
        "surfaceMode": "normal",
        "transparentAutoContrast": true,
        "transparentGhostStrength": 100,
        "backdropBlur": true,
        "edgeRoundness": 12,
        "transparency": 0.3,
        "titleAlign": "center",
        "contentAlignY": "top",
        "contentFillParent": false,
        "contentPadding": 10,
        "contentFontScale": 1,
        "widgetThemeMode": "inherit",
        "useCustomColors": false,
        "customTextColor": "#1F2226",
        "customAccentColor": "#1F4F9F",
        "customSurfaceColor": "#FFFAF2"
      }
    }
  },
  "presets": {
    "compact-grid": {
      "ui": {
        "home": {
          "gridColumns": 12,
          "gridRows": 8,
          "itemGap": "narrow"
        }
      }
    },
    "focus-surface": {
      "ui": {
        "widgetCommonMaster": {
          "surfaceMode": "normal",
          "contentFillParent": false
        }
      }
    }
  },
  "applyPresets": [
    "compact-grid",
    "focus-surface"
  ],
  "overrides": {
    "instances": [
      {
        "id": "clock-1",
        "type": "clock",
        "gridLayout": {
          "col": 0,
          "row": 0,
          "colSpan": 3,
          "rowSpan": 2
        }
      },
      {
        "id": "search-2",
        "type": "search",
        "config": {
          "provider": "google",
          "placeholder": "Search the web"
        },
        "gridLayout": {
          "col": 3,
          "row": 0,
          "colSpan": 6,
          "rowSpan": 1
        }
      },
      {
        "id": "weather-3",
        "type": "weather",
        "config": {
          "locationQuery": "Seoul",
          "temperatureUnit": "celsius",
          "detailMode": "simple",
          "refreshMinutes": 30
        },
        "gridLayout": {
          "col": 9,
          "row": 0,
          "colSpan": 3,
          "rowSpan": 1
        }
      },
      {
        "id": "shortcut-google-4",
        "type": "shortcut",
        "title": "Google",
        "config": {
          "label": "Google",
          "url": "https://www.google.com",
          "icon": "G",
          "faviconMode": "none",
          "openInNewTab": false,
          "useGlobalIconSize": true,
          "iconSizePercent": 100
        },
        "gridLayout": {
          "col": 3,
          "row": 1,
          "colSpan": 1,
          "rowSpan": 1
        }
      },
      {
        "id": "shortcut-youtube-5",
        "type": "shortcut",
        "title": "YouTube",
        "config": {
          "label": "YouTube",
          "url": "https://www.youtube.com",
          "icon": "YT",
          "faviconMode": "none",
          "openInNewTab": false,
          "useGlobalIconSize": true,
          "iconSizePercent": 100
        },
        "gridLayout": {
          "col": 4,
          "row": 1,
          "colSpan": 1,
          "rowSpan": 1
        }
      },
      {
        "id": "shortcut-github-6",
        "type": "shortcut",
        "title": "GitHub",
        "config": {
          "label": "GitHub",
          "url": "https://github.com",
          "icon": "GH",
          "faviconMode": "none",
          "openInNewTab": false,
          "useGlobalIconSize": true,
          "iconSizePercent": 100
        },
        "gridLayout": {
          "col": 5,
          "row": 1,
          "colSpan": 1,
          "rowSpan": 1
        }
      },
      {
        "id": "shortcut-chatgpt-7",
        "type": "shortcut",
        "title": "ChatGPT",
        "config": {
          "label": "ChatGPT",
          "url": "https://chatgpt.com",
          "icon": "AI",
          "faviconMode": "none",
          "openInNewTab": false,
          "useGlobalIconSize": true,
          "iconSizePercent": 100
        },
        "gridLayout": {
          "col": 6,
          "row": 1,
          "colSpan": 1,
          "rowSpan": 1
        }
      },
      {
        "id": "shortcut-gmail-8",
        "type": "shortcut",
        "title": "Gmail",
        "config": {
          "label": "Gmail",
          "url": "https://mail.google.com",
          "icon": "GM",
          "faviconMode": "none",
          "openInNewTab": false,
          "useGlobalIconSize": true,
          "iconSizePercent": 100
        },
        "gridLayout": {
          "col": 7,
          "row": 1,
          "colSpan": 1,
          "rowSpan": 1
        }
      },
      {
        "id": "shortcut-calendar-9",
        "type": "shortcut",
        "title": "Calendar",
        "config": {
          "label": "Calendar",
          "url": "https://calendar.google.com",
          "icon": "CAL",
          "faviconMode": "none",
          "openInNewTab": false,
          "useGlobalIconSize": true,
          "iconSizePercent": 100
        },
        "gridLayout": {
          "col": 8,
          "row": 1,
          "colSpan": 1,
          "rowSpan": 1
        }
      },
      {
        "id": "bookmarks-10",
        "type": "bookmarks",
        "gridLayout": {
          "col": 9,
          "row": 1,
          "colSpan": 3,
          "rowSpan": 4
        }
      },
      {
        "id": "todo-12",
        "type": "todo",
        "gridLayout": {
          "col": 0,
          "row": 2,
          "colSpan": 4,
          "rowSpan": 3
        }
      },
      {
        "id": "notes-13",
        "type": "notes",
        "gridLayout": {
          "col": 4,
          "row": 2,
          "colSpan": 5,
          "rowSpan": 3
        }
      }
    ]
  }
}
